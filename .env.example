# ==============================================================================
# Zotoz Capture — Environment Configuration (Template)
# ==============================================================================

# Google Gemini Flash API Key (Get free key from Google AI Studio: https://aistudio.google.com/)
# Note: When not configured, Zotoz automatically operates in verified Demo Mode with
# realistic Indian SMB sample procedures and structured output.
GEMINI_API_KEY=

# Supported Gemini Flash Model (e.g. gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Backend Server Port
PORT=5001

# Supabase Credentials (Optional — if not provided, local persistent JSON database is used)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
